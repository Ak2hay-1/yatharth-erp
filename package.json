{
  "name": "yatharth-erp",
  "version": "0.1.2",
  "private": true,
  "description": "Yatharth Foods ERP — plant office software",
  "author": "Yatharth Foods",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma migrate dev && prisma db seed",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "neon:env": "neon env pull",
    "neon:status": "neon status",
    "postinstall": "prisma generate",
    "desktop:dev": "electron electron/main.cjs --dev",
    "desktop:start": "npm run build && electron electron/main.cjs",
    "desktop:pack": "node scripts/prepare-pack.mjs",
    "desktop:win": "npm run build && node scripts/prepare-pack.mjs && electron-builder --win nsis --config electron-builder.yml"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.0.5",
    "@neon/env": "^1.1.5",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
