{
  "name": "yatharth-erp",
  "version": "0.1.1",
  "private": true,
  "description": "Yatharth Foods ERP — plant office software",
  "author": "Yatharth Foods",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma db push && prisma db seed",
    "postinstall": "prisma generate",
    "electron:dev": "electron . --dev",
    "electron:start": "npm run build && electron .",
    "prepare:pack": "node scripts/prepare-pack.mjs",
    "dist:win": "npm run build && node scripts/prepare-pack.mjs && electron-builder --win nsis"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
