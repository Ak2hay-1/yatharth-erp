DATABASE_URL=postgresql://yatharth:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/yatharth_sync
PORT=3001
HOST=0.0.0.0

# Shared with ERP Settings → Website sync (generate via scripts/Generate-ProdSecrets.ps1)
SYNC_SECRET=CHANGE_ME_SYNC_SECRET

WEBSITE_ORIGIN=https://yatharthafoods.in
UPLOAD_DIR=/data/uploads

VERCEL_REVALIDATE_URL=https://yatharthafoods.in/api/revalidate
REVALIDATE_WEBHOOK_SECRET=CHANGE_ME_REVALIDATE_SECRET

# Postgres (used by docker-compose.prod.yml)
POSTGRES_USER=yatharth
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=yatharth_sync

# Contact form email notify (optional — inquiries also appear in ERP Website sync panel)
CONTACT_NOTIFY_TO=accounts@yatharthfoods.in
CONTACT_NOTIFY_FROM=noreply@yatharthafoods.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or POST JSON to a webhook instead of SMTP:
# CONTACT_NOTIFY_WEBHOOK=https://hooks.example.com/contact
